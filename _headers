# Cloudflare headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# Third-party requests: exactly one, and only for anonymous visit counts.
# Cloudflare Web Analytics loads beacon.min.js from static.cloudflareinsights.com and
# beacons to cloudflareinsights.com. The only first-party request is a cookieless POST /e
# that counts a named event — never document content, never an identifier. Nothing else
# leaves the origin.
#
# script-src stays free of 'unsafe-inline': no inline <script>, no inline styles and no
# inline event handlers anywhere in the markup.
#
# connect-src keeps 'self'. The funnel counter posts to our own /e with sendBeacon, and
# without 'self' the browser refuses even to read our own /robots.txt and /sitemap.xml,
# which breaks same-origin tooling (Lighthouse reports "robots.txt is not valid").
#
# manifest-src and worker-src have to be named explicitly. Both fall back to default-src,
# which is 'none', so the web app manifest would be blocked and the service worker could not
# register. Chrome only fetches the manifest once a page is installable — i.e. once a service
# worker exists — so this is inert until W-1 lands and then becomes load-bearing.
#
# COOP (L-2) is global: the editor never relies on a cross-origin opener, and `same-origin`
# gives the document its own browsing-context group. CORP is NOT global on purpose — the
# OpenGraph image and the public icons must stay embeddable by social previews, so it is
# scoped below to the application document and to served code/styles only.
#
# Permissions-Policy (L-3) lists only features Chromium implements; `tools` was an origin-trial
# directive and only produced a console warning.
#
# HSTS (L-1) is not set here: the zone sends `max-age=31536000; includeSubDomains` for every
# response (SSL/TLS -> Edge Certificates -> HSTS), so a second header here would only duplicate
# it. Change HSTS in the zone, not in this file.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# L-2: the editor document and every served script/stylesheet are same-origin resources.
# `/app/*` also covers `/app/index.html`; `*` matches slashes, so `/*.js` and `/*.css` cover
# `/app.js`, `/vendor/*.js`, `/sw.js` and both stylesheets.
/app
  Cross-Origin-Resource-Policy: same-origin
/app/*
  Cross-Origin-Resource-Policy: same-origin
/*.js
  Cross-Origin-Resource-Policy: same-origin
/*.css
  Cross-Origin-Resource-Policy: same-origin

# Self-hosted variable fonts never change in place — cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

# Pin the served MIME for every document type.
#
# On a Worker with static assets the direct-upload API records the Content-Type sent for
# each file part and keys assets by content hash, so a stored type cannot be corrected
# without changing the file bytes. These pins make the served type independent of that.
# (Cloudflare Pages derives MIME from the extension; the pins are harmless there.)
#
# The HTML documents also carry `Cache-Control: public, max-age=0, must-revalidate,
# no-transform`. The first half is what Pages already sends for HTML, so the documents stay
# revalidated and a deploy is never masked by a cached copy. `no-transform` is the part
# that matters here: on the custom domain Cloudflare rewrites the published contact
# address into an obfuscated `__cfemail__` link, which hides the address from the reader
# and rewrites the mailto: href. With `no-transform` the HTML is served exactly as
# authored. The address is also wrapped in `<!--email_off-->` in the markup, which is
# Cloudflare's own per-address opt-out, so the two agree.
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/app/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/app/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/typora/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/typora/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/calmlywriter/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/compare/calmlywriter/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/styles.css
  Content-Type: text/css; charset=utf-8
/landing.css
  Content-Type: text/css; charset=utf-8
/app.js
  Content-Type: text/javascript; charset=utf-8
/landing.js
  Content-Type: text/javascript; charset=utf-8
# DD-03: the storage layer, loaded before /app.js. Same reason /app.js is pinned: under
# `nosniff`, an upload that records application/octet-stream would stop the editor dead.
/stories.js
  Content-Type: text/javascript; charset=utf-8
# WebMCP tools (W3C CG draft). Same pin as the other scripts: `nosniff` refuses a
# mis-typed upload, and the tools would silently disappear for every visitor.
/webmcp.js
  Content-Type: text/javascript; charset=utf-8

# The service worker must never be answered from a stale cache — that is the one failure
# mode that can outlive a deploy — and it must keep a pinned type: a worker fetched as
# application/octet-stream under nosniff is refused outright, which would silently disable
# offline support for every returning visitor.
/sw.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache

# Vendored libraries (marked, DOMPurify): pin the type so a future re-upload cannot
# silently break them under `nosniff`.
/vendor/*
  Content-Type: text/javascript; charset=utf-8

# Non-HTML documents and images.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

# Agent-facing discovery documents. Pinned types for the same `nosniff` reason as the
# scripts: a markdown or JSON file served as octet-stream is unusable to every client.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/index.md
  Content-Type: text/markdown; charset=utf-8
/agent-skill.md
  Content-Type: text/markdown; charset=utf-8
/AGENTS.md
  Content-Type: text/markdown; charset=utf-8
/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/ard.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
/og.png
  Content-Type: image/png
/icon-192.png
  Content-Type: image/png
/icon-512.png
  Content-Type: image/png
/favicon_io/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800
/favicon_io/favicon-16x16.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
/favicon_io/favicon-32x32.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
/favicon_io/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
# The hero photograph. One self-hosted WebP; the type is pinned for the same `nosniff`
# reason as the scripts. Not `immutable`: the scene may be replaced in place.
/landing-bg.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=604800

# Admin metrics dashboard and its API: never cache, never index.
/admin/metrics.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: no-store
/admin/*
  Cache-Control: no-store
/api/*
  Cache-Control: no-store
